{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",

  "metadata": [
    {
      "src": [
        {
          "src": "../../Library/ScriptAssemblies",
          "files": [
            "YShared.Runtime.dll"
          ]
        }
      ],
      "dest": "api"
    }
  ],

  "build": {
    "content": [
      {
        "files": [
          "**/*.md",
          "**/*.yml"
        ],
        "exclude": [
          "_site/**"
        ]
      }
    ],

    "resource": [
      {
        "files": [
          "images/**"
        ]
      }
    ],

    "output": "_site",

    "template": [
      "default",
      "modern"
    ],

    "globalMetadata": {
      "_appName": "yshared",
      "_appTitle": "yshared",
      "_enableSearch": true,
      "pdf": true
    }
  }
}